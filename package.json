{
  "name": "@foss-earth/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Injected settings, window state and feature contribution lifecycle for FOSS Earth hosts.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    "./theme.css": {
      "types": "./assets/theme-css.d.ts",
      "source": "./assets/theme.css",
      "default": "./assets/theme.css"
    },
    "./theme-page.js": {
      "types": "./assets/theme-page.d.ts",
      "source": "./assets/theme-page.js",
      "default": "./assets/theme-page.js"
    },
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./settings": {
      "source": "./src/settings/index.ts",
      "types": "./dist/settings/index.d.ts",
      "import": "./dist/settings/index.js"
    },
    "./windowing": {
      "source": "./src/windowing/index.ts",
      "types": "./dist/windowing/index.d.ts",
      "import": "./dist/windowing/index.js"
    },
    "./contributions": {
      "source": "./src/contributions.ts",
      "types": "./dist/contributions.d.ts",
      "import": "./dist/contributions.js"
    },
    "./browser": {
      "source": "./src/browser/index.ts",
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./react": {
      "source": "./src/react.ts",
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./styles.css": {
      "source": "./src/styles/ui.css",
      "default": "./dist/styles/ui.css"
    },
    "./windowing.css": {
      "source": "./src/windowing/styles/windowing.css",
      "default": "./dist/windowing/styles/windowing.css"
    },
    "./diagnostics": {
      "source": "./src/diagnostics/index.ts",
      "types": "./dist/diagnostics/index.d.ts",
      "import": "./dist/diagnostics/index.js"
    },
    "./dial.css": {
      "source": "./src/styles/dial.css",
      "default": "./dist/styles/dial.css"
    },
    "./log.css": {
      "source": "./src/styles/gameLog.css",
      "default": "./dist/styles/gameLog.css"
    },
    "./status.css": {
      "source": "./src/styles/status.css",
      "default": "./dist/styles/status.css"
    },
    "./mesh-inspector.css": {
      "source": "./src/styles/meshInspector.css",
      "default": "./dist/styles/meshInspector.css"
    },
    "./vite": {
      "types": "./vite/index.d.mts",
      "import": "./vite/index.mjs"
    }
  },
  "files": [
    "scripts/create-test-link.mjs",
    "assets",
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "fixtures",
    "AGENTS.md",
    "vite",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit --tsBuildInfoFile node_modules/.tmp/typecheck.tsbuildinfo",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "test": "vitest run --maxWorkers=50%",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:consumer": "node tests/package-consumer.mjs",
    "typecheck:consumer": "node tests/package-consumer.mjs",
    "ci": "npm run check:implementation",
    "check:implementation": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:consumer"
  },
  "peerDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4",
    "globals": "17.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "jsdom": "29.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vitest": "4.1.6"
  }
}
