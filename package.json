{
  "name": "@foss-earth/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Injected settings, window state and feature contribution lifecycle for FOSS Earth hosts.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./settings": {
      "types": "./dist/settings/index.d.ts",
      "import": "./dist/settings/index.js"
    },
    "./windowing": {
      "types": "./dist/windowing/index.d.ts",
      "import": "./dist/windowing/index.js"
    },
    "./contributions": {
      "types": "./dist/contributions.d.ts",
      "import": "./dist/contributions.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./styles.css": "./dist/styles/ui.css",
    "./windowing.css": "./dist/windowing/styles/windowing.css",
    "./diagnostics": {
      "types": "./dist/diagnostics/index.d.ts",
      "import": "./dist/diagnostics/index.js"
    },
    "./dial.css": "./dist/styles/dial.css",
    "./log.css": "./dist/styles/gameLog.css",
    "./status.css": "./dist/styles/status.css",
    "./mesh-inspector.css": "./dist/styles/meshInspector.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "provenance.json",
    "fixtures",
    "SOURCE_LINEAGE.json",
    "SOURCE_RECEIPT.json",
    "AGENTS.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    ".attribution.json",
    ".attribution-release.json",
    ".github/workflows/attribution-check.yml",
    "deps/foss-earth-ci-1db73d1ddb342e348a2c9e8387f7bbc7ebb3225e.tgz"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit --tsBuildInfoFile node_modules/.tmp/typecheck.tsbuildinfo",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "test": "vitest run --maxWorkers=50%",
    "test:consumer": "node tests/package-consumer.mjs",
    "typecheck:consumer": "node tests/package-consumer.mjs",
    "ci": "npm run check:conformance && npm run check:implementation",
    "prepare:consumer-dependencies": "node tests/prepare-consumer-dependencies.mjs",
    "check:conformance": "node node_modules/@foss-earth/ci/bin/conformance.mjs --consumer . --trusted-release .attribution-release.json --output-root build/common-conformance",
    "check:attribution": "node node_modules/@foss-earth/ci/bin/attribution.mjs --repo . --refs-file build/repository-split/intended-publication-refs.json",
    "check:implementation": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:consumer"
  },
  "peerDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4",
    "globals": "17.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "jsdom": "29.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vitest": "4.1.6",
    "@foss-earth/ci": "file:deps/foss-earth-ci-1db73d1ddb342e348a2c9e8387f7bbc7ebb3225e.tgz"
  }
}
